label="[p]  ([-1].cb1)" 
 subgraph "cluster_top.([-1].cb1).([0].nt1)" {
label="nt0"  "top.([-1].cb1).([0].nt1)" [
                rankdir="TB"
                label = "{ <S> S↲| <G> G| <D> D }"
                shape="record"
            ]
}
 "top.([-1].cb1).in" [shape=plaintext, width=0.1, label="in", color="darkgoldenrod", style=filled, fontsize=10];    
 "top.([-1].cb1).out" [shape=plaintext, width=0.1, label="out", color="darkgoldenrod", style=filled, fontsize=10];    
 "top.([-1].cb1).source" [shape=plaintext, width=0.1, label="source", color="darkgoldenrod", style=filled, fontsize=10];    
