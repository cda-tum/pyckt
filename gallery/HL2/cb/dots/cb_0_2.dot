            ]
}
 "top.([-1].cb1).in_source" [shape=plaintext, width=0.1, label="in_source", color="darkgoldenrod", style=filled, fontsize=10];    
 "top.([-1].cb1).inner" [shape=plaintext, width=0.1, label="inner", color="darkgoldenrod", style=filled, fontsize=10];    
 "top.([-1].cb1).source" [shape=plaintext, width=0.1, label="source", color="darkgoldenrod", style=filled, fontsize=10];    
 "top.([-1].cb1).in_output" [shape=plaintext, width=0.1, label="in_output", color="darkgoldenrod", style=filled, fontsize=10];    
 "top.([-1].cb1).out" [shape=plaintext, width=0.1, label="out", color="darkgoldenrod", style=filled, fontsize=10];    
 "top.([-1].cb1).in_source" -> "top.([-1].cb1).([0].dt1)": G [arrowhead=none]; 
 "top.([-1].cb1).inner" -> "top.([-1].cb1).([0].dt1)": D [arrowhead=none]; 
 "top.([-1].cb1).inner" -> "top.([-1].cb1).([1].nt1)": S [arrowhead=none]; 
 "top.([-1].cb1).source" -> "top.([-1].cb1).([0].dt1)": S [arrowhead=none]; 
 "top.([-1].cb1).in_output" -> "top.([-1].cb1).([1].nt1)": G [arrowhead=none]; 
 "top.([-1].cb1).out" -> "top.([-1].cb1).([1].nt1)": D [arrowhead=none]; 

